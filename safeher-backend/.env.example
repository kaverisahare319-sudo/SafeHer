PORT=5000

# MongoDB Atlas connection string (get from mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safeher

# Any random long string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Fast2SMS API key (get free key from fast2sms.com after signup)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Comma-separated list of frontend URLs allowed to call this backend
FRONTEND_URL=http://localhost:5500,https://your-frontend.vercel.app
